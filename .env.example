# Compose 项目名（小写字母/数字/-/_），避免中文目录名导致 project name 为空
COMPOSE_PROJECT_NAME=gxlogic-bank

DB_NAME=gxlogic_bank
DB_USER=gxlogic
DB_PASSWORD=gxlogic_pwd

JWT_SECRET=change_me_to_a_long_random_string
DJANGO_SECRET_KEY=change_me_django_secret_key
DJANGO_DEBUG=0

# 运营后台账号（后端启动时幂等创建，用于处理题目报错）
OPS_USERNAME=ops
OPS_PASSWORD=ops123456

FRONTEND_PORT=18505
BACKEND_PORT=19505
DB_PORT=33505
